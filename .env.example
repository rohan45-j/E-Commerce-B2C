# ==============================================================================
# Environment Configuration Template: Next.js Premium E-Commerce
# ==============================================================================
# Copy this file to .env.local for local development.
# WARNING: NEVER commit .env or .env.local with real credentials!
# ==============================================================================

# Database (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/ecommerce_b2c?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/ecommerce_b2c?schema=public"

# App & Site Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Dhaka Premium E-Commerce"
NEXT_PUBLIC_CURRENCY="BDT"
NEXT_PUBLIC_CURRENCY_SYMBOL="৳"
BUSINESS_TIMEZONE="Asia/Dhaka"

# Auth.js (NextAuth v5)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Payments (Cash on Delivery + Stripe + bKash / SSLCOMMERZ ready)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_SANDBOX="true"

# Image Upload (Cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="orders@yourdomain.com"

# Admin Initial Seed Credentials
ADMIN_NAME="System Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!@#"
